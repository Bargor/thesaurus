{
  "name": "thesaurus-firebase-rules",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules:direct": "node --test tests/firestore.rules.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-thesaurus --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:hosting": "firebase emulators:exec --project demo-thesaurus --only hosting \"node --test tests/hosting.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.17.0"
  }
}
